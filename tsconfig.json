{
  "compilerOptions": {
    "module": "CommonJS",
    "target": "ES2020",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node", "jest"],
    "baseUrl": ".",
    "paths": {
      "@composer-os/*": ["engines/composer-os-v2/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "validation/**/*.ts",
    "engines/**/*.ts",
    "engines/**/*.d.ts",
    "scripts/**/*.ts",
    "shared/**/*.ts",
    "tools/**/*.ts"
  ]
}
