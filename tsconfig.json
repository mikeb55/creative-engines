{
  "compilerOptions": {
    "module": "CommonJS",
    "target": "ES2020",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": [
    "src/**/*.ts",
    "validation/**/*.ts",
    "engines/**/*.ts",
    "engines/**/*.d.ts",
    "scripts/**/*.ts",
    "shared/**/*.ts",
    "tools/**/*.ts"
  ]
}
