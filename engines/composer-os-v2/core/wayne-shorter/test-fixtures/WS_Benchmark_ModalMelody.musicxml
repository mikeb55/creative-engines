<?xml version="1.0" encoding="UTF-8"?>
<score-partwise version="3.1">
  <part-list>
    <score-part id="P1"><part-name>Melody</part-name></score-part>
  </part-list>
  <part id="P1">
    <measure number="1">
      <attributes>
        <divisions>4</divisions>
        <key><fifths>-2</fifths><mode>minor</mode></key>
        <time><beats>4</beats><beat-type>4</beat-type></time>
      </attributes>
      <harmony><root><root-step>D</root-step></root><kind>minor-seventh</kind></harmony>
      <!-- floating sustain opening -->
      <note><pitch><step>D</step><octave>5</octave></pitch><duration>6</duration><voice>1</voice></note>
      <note><pitch><step>F</step><octave>5</octave></pitch><duration>2</duration><voice>1</voice></note>
      <note><rest/><duration>8</duration><voice>1</voice></note>
    </measure>
    <measure number="2">
      <harmony><root><root-step>D</root-step></root><kind>minor-seventh</kind></harmony>
      <!-- compact burst + space -->
      <note><rest/><duration>2</duration><voice>1</voice></note>
      <note><pitch><step>A</step><octave>4</octave></pitch><duration>1</duration><voice>1</voice></note>
      <note><pitch><step>C</step><octave>5</octave></pitch><duration>1</duration><voice>1</voice></note>
      <note><pitch><step>D</step><octave>5</octave></pitch><duration>1</duration><voice>1</voice></note>
      <note><pitch><step>E</step><octave>5</octave></pitch><duration>2</duration><voice>1</voice></note>
      <note><rest/><duration>9</duration><voice>1</voice></note>
      <note><pitch><step>G</step><octave>4</octave></pitch><duration>2</duration><voice>1</voice></note>
    </measure>
    <measure number="3">
      <harmony><root><root-step>F</root-step></root><kind>major-seventh</kind></harmony>
      <!-- long sustained float -->
      <note><pitch><step>A</step><octave>4</octave></pitch><duration>12</duration><voice>1</voice></note>
      <note><pitch><step>C</step><octave>5</octave></pitch><duration>4</duration><voice>1</voice></note>
    </measure>
    <measure number="4">
      <harmony><root><root-step>F</root-step></root><kind>major-seventh</kind></harmony>
      <!-- intervallic pivot -->
      <note><pitch><step>E</step><octave>5</octave></pitch><duration>2</duration><voice>1</voice></note>
      <note><pitch><step>B</step><alter>-1</alter><octave>4</octave></pitch><duration>3</duration><voice>1</voice></note>
      <note><pitch><step>G</step><octave>4</octave></pitch><duration>4</duration><voice>1</voice></note>
      <note><rest/><duration>7</duration><voice>1</voice></note>
    </measure>
    <measure number="5">
      <harmony><root><root-step>E</root-step><alter>-1</alter></root><kind>major-seventh</kind></harmony>
      <!-- delayed entry + space -->
      <note><rest/><duration>4</duration><voice>1</voice></note>
      <note><pitch><step>F</step><octave>4</octave></pitch><duration>8</duration><voice>1</voice></note>
      <note><pitch><step>G</step><octave>4</octave></pitch><duration>4</duration><voice>1</voice></note>
    </measure>
    <measure number="6">
      <harmony><root><root-step>E</root-step><alter>-1</alter></root><kind>major-seventh</kind></harmony>
      <!-- compact burst then leap sustain -->
      <note><pitch><step>A</step><alter>-1</alter><octave>4</octave></pitch><duration>1</duration><voice>1</voice></note>
      <note><pitch><step>B</step><alter>-1</alter><octave>4</octave></pitch><duration>1</duration><voice>1</voice></note>
      <note><pitch><step>C</step><octave>5</octave></pitch><duration>1</duration><voice>1</voice></note>
      <note><pitch><step>D</step><octave>5</octave></pitch><duration>2</duration><voice>1</voice></note>
      <note><rest/><duration>3</duration><voice>1</voice></note>
      <note><pitch><step>F</step><octave>5</octave></pitch><duration>6</duration><voice>1</voice></note>
      <note><rest/><duration>2</duration><voice>1</voice></note>
    </measure>
    <measure number="7">
      <harmony><root><root-step>A</root-step></root><kind>minor-seventh</kind></harmony>
      <!-- whole-bar floating tone -->
      <note><pitch><step>E</step><octave>5</octave></pitch><duration>16</duration><voice>1</voice></note>
    </measure>
    <measure number="8">
      <harmony><root><root-step>D</root-step></root><kind>minor-seventh</kind></harmony>
      <!-- phrase arc close — chases idea, no strong cadential landing -->
      <note><pitch><step>C</step><octave>5</octave></pitch><duration>4</duration><voice>1</voice></note>
      <note><rest/><duration>2</duration><voice>1</voice></note>
      <note><pitch><step>A</step><octave>4</octave></pitch><duration>3</duration><voice>1</voice></note>
      <note><pitch><step>D</step><octave>5</octave></pitch><duration>4</duration><voice>1</voice></note>
      <note><rest/><duration>3</duration><voice>1</voice></note>
    </measure>
  </part>
</score-partwise>
