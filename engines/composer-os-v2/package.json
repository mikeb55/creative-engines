{
  "name": "composer-os-v2",
  "version": "2.0.0",
  "private": true,
  "description": "V2.0 - Composer OS unified generative composition system",
  "main": "core/conductor/conductor.js",
  "scripts": {
    "test:composer-os-regression": "jest --config jest.config.cjs tests/regression/phase191EnsembleRegression.test.ts --no-coverage",
    "test:jest:counterpoint": "jest --config jest.config.cjs voiceLeadingScorer --no-coverage",
    "test": "node --max-old-space-size=4096 ../../node_modules/ts-node/dist/bin.js --project ../../tsconfig.json tests/runAllTests.ts",
    "test:retro": "npx ts-node --project ../../tsconfig.json scripts/runRetroSelfTests.ts",
    "sibelius:diagnostic-variants": "npx ts-node --project ../../tsconfig.json scripts/sibeliusDiagnosticVariants.ts",
    "polyphony:diagnostic-export": "npx ts-node --project ../../tsconfig.json scripts/polyphonyDiagnosticExportCli.ts",
    "test:c3-james-brown": "npx ts-node --transpile-only --project ../../tsconfig.json tests/jamesBrownFunkOverlayRegression.test.ts",
    "d1:selftest": "npx ts-node --transpile-only --project ../../tsconfig.json scripts/d1Selftest.ts",
    "test:duo": "npx ts-node --project ../../tsconfig.json scripts/duo-regression-sweep.ts",
    "test:bass": "npx ts-node --project ../../tsconfig.json scripts/bass-phrase-sweep.ts",
    "test:vocal": "npx ts-node --project ../../tsconfig.json scripts/test-vocal-lead-sheet.ts",
    "export:wyble-examples": "npx ts-node --transpile-only --project ../../tsconfig.json scripts/exportWybleOnOffExamples.ts",
    "eval:fagen": "npx ts-node --transpile-only --project ../../tsconfig.json scripts/runFagenSongModeEval.ts",
    "eval:style-soph-pop": "npx ts-node --transpile-only --project ../../tsconfig.json scripts/runSophisticatedPopStyleEval.ts",
    "eval:bacharach": "npx ts-node --transpile-only --project ../../tsconfig.json scripts/runBacharachSongModeEval.ts",
    "workflow:bacharach": "npx ts-node --transpile-only --project ../../tsconfig.json scripts/runBacharachWorkflow.ts",
    "mine:bacharach": "npx ts-node --transpile-only --project ../../tsconfig.json scripts/runBacharachReferenceMining.ts",
    "eval:gce-styles": "npx ts-node --project ../../tsconfig.json scripts/gceStyleEval.ts",
    "verify:eras": "ts-node scripts/eraVerification.ts",
    "test:ecm": "ts-node scripts/testEcmStability.ts",
    "test:motif-authority": "ts-node scripts/testMotifAuthority.ts"
  },
  "types": "./core/conductor/conductorTypes.ts",
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^25.6.0",
    "@xmldom/xmldom": "^0.9.9",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.0.0"
  }
}
