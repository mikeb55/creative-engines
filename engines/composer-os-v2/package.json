{
  "name": "composer-os-v2",
  "version": "2.0.0",
  "private": true,
  "description": "V2.0 - Composer OS unified generative composition system",
  "main": "core/conductor/conductor.js",
  "scripts": {
    "build": "node -e \"console.log('[composer-os-v2] No dist emit; API/dev loads .ts via root ts-node.');\"",
    "test:composer-os-regression": "jest --config jest.config.cjs tests/regression/phase191EnsembleRegression.test.ts --no-coverage",
    "test:jest:counterpoint": "jest --config jest.config.cjs voiceLeadingScorer --no-coverage",
    "test": "node --max-old-space-size=4096 ../../node_modules/ts-node/dist/bin.js --project ../../tsconfig.json tests/runAllTests.ts full",
    "test:full": "node --max-old-space-size=4096 ../../node_modules/ts-node/dist/bin.js --project ../../tsconfig.json tests/runAllTests.ts full",
    "test:fast": "node --max-old-space-size=4096 ../../node_modules/ts-node/dist/bin.js --project ../../tsconfig.json tests/runAllTests.ts fast",
    "test:smoke": "node --max-old-space-size=4096 ../../node_modules/ts-node/dist/bin.js --project ../../tsconfig.json tests/runSmokeTests.ts",
    "test:smoke-fast": "node -e \"process.env.COMPOSER_OS_SMOKE_TIER='fast';const {spawnSync}=require('child_process');const r=spawnSync(process.execPath,['--max-old-space-size=4096','../../node_modules/ts-node/dist/bin.js','--project','../../tsconfig.json','tests/runSmokeTests.ts'],{stdio:'inherit',env:process.env,cwd:process.cwd()});process.exit(r.status??1)\"",
    "test:retro": "npx ts-node --project ../../tsconfig.json scripts/runRetroSelfTests.ts",
    "sibelius:diagnostic-variants": "npx ts-node --project ../../tsconfig.json scripts/sibeliusDiagnosticVariants.ts",
    "polyphony:diagnostic-export": "npx ts-node --project ../../tsconfig.json scripts/polyphonyDiagnosticExportCli.ts",
    "test:c3-james-brown": "npx ts-node --transpile-only --project ../../tsconfig.json tests/jamesBrownFunkOverlayRegression.test.ts",
    "d1:selftest": "npx ts-node --transpile-only --project ../../tsconfig.json scripts/d1Selftest.ts",
    "test:duo": "npx ts-node --project ../../tsconfig.json scripts/duo-regression-sweep.ts",
    "test:bass": "npx ts-node --project ../../tsconfig.json scripts/bass-phrase-sweep.ts",
    "test:vocal": "npx ts-node --project ../../tsconfig.json scripts/test-vocal-lead-sheet.ts",
    "export:wyble-examples": "npx ts-node --transpile-only --project ../../tsconfig.json scripts/exportWybleOnOffExamples.ts",
    "eval:fagen": "npx ts-node --transpile-only --project ../../tsconfig.json scripts/runFagenSongModeEval.ts",
    "eval:brian_wilson": "npx ts-node --transpile-only --project ../../tsconfig.json scripts/runBrianWilsonSongModeEval.ts",
    "eval:stevie_wonder": "npx ts-node --transpile-only --project ../../tsconfig.json scripts/runStevieWonderSongModeEval.ts",
    "eval:radiohead": "npx ts-node --transpile-only --project ../../tsconfig.json scripts/runRadioheadSongModeEval.ts",
    "eval:joni_mitchell": "npx ts-node --transpile-only --project ../../tsconfig.json scripts/runJoniMitchellSongModeEval.ts",
    "eval:sonic_youth": "npx ts-node --transpile-only --project ../../tsconfig.json scripts/runSonicYouthSongModeEval.ts",
    "eval:pat_metheny": "npx ts-node --transpile-only --project ../../tsconfig.json scripts/runPatMethenySongModeEval.ts",
    "probe:pat-metheny-eligibility": "npx ts-node --transpile-only --project ../../tsconfig.json scripts/patMethenyEligibilityProbe.ts",
    "eval:james_brown": "npx ts-node --transpile-only --project ../../tsconfig.json scripts/runJamesBrownSongModeEval.ts",
    "eval:style-soph-pop": "npx ts-node --transpile-only --project ../../tsconfig.json scripts/runSophisticatedPopStyleEval.ts",
    "eval:bacharach": "npx ts-node --transpile-only --project ../../tsconfig.json scripts/runBacharachSongModeEval.ts",
    "workflow:bacharach": "npx ts-node --transpile-only --project ../../tsconfig.json scripts/runBacharachWorkflow.ts",
    "mine:bacharach": "npx ts-node --transpile-only --project ../../tsconfig.json scripts/runBacharachReferenceMining.ts",
    "orbit:steely-v1": "npx ts-node --transpile-only --project ../../tsconfig.json scripts/generateSteelyOrbitV1.ts",
    "orbit:steely-v2": "npx ts-node --transpile-only --project ../../tsconfig.json scripts/generateSteelyOrbitV1.ts",
    "gce:seed-structural-fingerprints": "npx ts-node --transpile-only --project ../../tsconfig.json scripts/seedGceStructuralFingerprints.ts",
    "eval:gce-styles": "npx ts-node --project ../../tsconfig.json scripts/gceStyleEval.ts",
    "verify:eras": "ts-node scripts/eraVerification.ts",
    "test:ecm": "ts-node scripts/testEcmStability.ts",
    "probe:ecm-arrangement": "ts-node scripts/ecmArrangementProbe.ts",
    "eval:ecm-texture": "npx ts-node --transpile-only --project ../../tsconfig.json scripts/ecmChamberTextureEval.ts",
    "inspect:songmode-ab": "npx ts-node --transpile-only --project ../../tsconfig.json scripts/runSongModeAbInspect.ts",
    "eval:riff-diagnostics": "npx ts-node --transpile-only --project ../../tsconfig.json scripts/runRiffEvalDiagnostics.ts",
    "eval:riff-top": "npx ts-node --transpile-only --project ../../tsconfig.json scripts/runRiffEvalTopCandidates.ts",
    "eval:duo-diagnostics": "npx ts-node --transpile-only --project ../../tsconfig.json scripts/runDuoEvalDiagnostics.ts",
    "eval:duo-top": "npx ts-node --transpile-only --project ../../tsconfig.json scripts/runDuoEvalTopCandidates.ts",
    "test:motif-authority": "ts-node scripts/testMotifAuthority.ts",
    "test:big-band-arranging": "ts-node scripts/testBigBandArranging.ts",
    "eval:big-band-chart": "ts-node scripts/bigBandChartEval.ts"
  },
  "types": "./core/conductor/conductorTypes.ts",
  "dependencies": {
    "creative-engines": "file:../..",
    "fflate": "^0.8.2",
    "ireal-reader": "^1.3.1",
    "midi-writer-js": "^3.2.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^25.6.0",
    "@xmldom/xmldom": "^0.9.9",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.0.0"
  }
}
